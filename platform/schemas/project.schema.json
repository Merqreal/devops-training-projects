{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevOps project definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "version",
    "primary_domain",
    "domains",
    "difficulty",
    "estimated_effort",
    "technologies",
    "tags",
    "prerequisites",
    "learning_objectives",
    "status",
    "content_path",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^DEVOPS-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^|\\n\\r]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "primary_domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimated_effort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "unit"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "const": "hours"
        }
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skills",
        "tools",
        "projects"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "projects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DEVOPS-[0-9]{3,}$"
          }
        }
      }
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "archived"
      ]
    },
    "content_path": {
      "type": "string",
      "pattern": "^projects/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "file"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.md$"
          }
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "replacement_id": {
          "type": "string",
          "pattern": "^DEVOPS-[0-9]{3,}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "deprecated",
              "archived"
            ]
          }
        }
      },
      "then": {
        "required": [
          "deprecation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "deprecation"
          ]
        }
      }
    }
  ]
}
